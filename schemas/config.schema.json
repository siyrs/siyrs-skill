{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/siyrs/siyrs-skill/schemas/config.schema.json",
  "title": "siyrs-skill project configuration",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {"const": 1},
    "project": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "modules": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "git": {
      "type": "object",
      "properties": {
        "default_branch": {"type": "string"},
        "remote": {"type": "string"},
        "sync_mode": {"enum": ["current-branch"]},
        "integration": {"enum": ["rebase", "merge", "ff-only"]},
        "create_pr": {"type": "boolean"},
        "require_clean_preflight": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "testing": {
      "type": "object",
      "properties": {
        "full_mode": {"enum": ["quick", "standard", "strict"]},
        "new_mode": {"enum": ["quick", "standard", "strict"]},
        "sync_mode": {"enum": ["quick", "standard", "strict"]},
        "coverage": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "minimum": {"type": "number", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": true
        },
        "commands": {
          "type": "object",
          "properties": {
            "quick": {"type": "array", "items": {"type": "string"}},
            "standard": {"type": "array", "items": {"type": "string"}},
            "strict": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "paths": {"type": "object", "additionalProperties": {"type": "string"}},
    "exclude": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
