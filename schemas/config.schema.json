{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/siyrs/siyrs-skill/schemas/config.schema.json",
  "title": "siyrs-skill project configuration v2",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {"const": 2},
    "project": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "path"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "testing": {"type": "object", "additionalProperties": true}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "git": {
      "type": "object",
      "properties": {
        "default_branch": {"type": "string"},
        "remote": {"type": "string"},
        "sync_mode": {"enum": ["current-branch"]},
        "integration": {"enum": ["rebase", "merge", "ff-only"]},
        "create_pr": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "testing": {
      "type": "object",
      "properties": {
        "authoring": {
          "type": "object",
          "properties": {
            "default_depth": {"enum": ["quick", "standard", "strict"]}
          },
          "additionalProperties": true
        },
        "tiers": {
          "type": "object",
          "properties": {
            "t1": {"$ref": "#/$defs/tierCommands"},
            "t2": {
              "allOf": [
                {"$ref": "#/$defs/tierCommands"},
                {
                  "type": "object",
                  "properties": {
                    "selector_id": {"type": "string", "minLength": 1},
                    "required_per_module": {
                      "type": "object",
                      "properties": {
                        "main_path": {"type": "integer", "minimum": 1},
                        "boundary": {"type": "integer", "minimum": 1}
                      },
                      "additionalProperties": false
                    }
                  }
                }
              ]
            },
            "t3": {
              "allOf": [
                {"$ref": "#/$defs/tierCommands"},
                {
                  "type": "object",
                  "properties": {
                    "require_real_uat": {"type": "boolean"},
                    "release_gate": {"type": "boolean"}
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "preflight": {
          "type": "object",
          "properties": {
            "commit": {"enum": ["t1", "none"]},
            "sync_after_integration": {"enum": ["t1", "none"]},
            "pr": {"enum": ["t2", "none"]}
          },
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "minimum": {"type": "number", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "paths": {"type": "object", "additionalProperties": {"type": "string"}},
    "exclude": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "tierCommands": {
      "type": "object",
      "properties": {
        "commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "baseline": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
