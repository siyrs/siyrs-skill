{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/siyrs/siyrs-skill/schemas/state.schema.json",
  "title": "siyrs-skill state v2",
  "type": "object",
  "required": ["version", "last_authoring", "last_t1_run", "last_t2_run", "last_t3_run"],
  "properties": {
    "version": {"const": 2},
    "last_authoring": {"$ref": "#/$defs/authoringRecord"},
    "last_t1_run": {"$ref": "#/$defs/t1Record"},
    "last_t2_run": {"$ref": "#/$defs/t2Record"},
    "last_t3_run": {"$ref": "#/$defs/t3Record"},
    "last_release_gate": {"$ref": "#/$defs/releaseGateRecord"},
    "migration": {"type": ["object", "null"], "additionalProperties": true},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "status": {"enum": ["complete", "partially-complete", "failed", "blocked", "unknown", null]},
    "commonProperties": {
      "kind": {"enum": ["authoring", "t1", "t2", "t3"]},
      "commit": {"type": ["string", "null"]},
      "fingerprint": {"type": ["string", "null"]},
      "tree_oid": {"type": ["string", "null"]},
      "baseline_commit": {"type": ["string", "null"]},
      "status": {"$ref": "#/$defs/status"},
      "results_file": {"type": ["string", "null"]},
      "case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "expanded_modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "blocked_suites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "updated_at": {"type": ["string", "null"], "format": "date-time"}
    },
    "authoringRecord": {
      "type": "object",
      "required": ["kind", "case_ids", "modules", "expanded_modules", "blocked_suites", "depth"],
      "properties": {
        "kind": {"const": "authoring"},
        "commit": {"type": ["string", "null"]},
        "fingerprint": {"type": ["string", "null"]},
        "tree_oid": {"type": ["string", "null"]},
        "baseline_commit": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/status"},
        "results_file": {"type": ["string", "null"]},
        "case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "expanded_modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blocked_suites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "updated_at": {"type": ["string", "null"], "format": "date-time"},
        "depth": {"enum": ["quick", "standard", "strict", null]}
      },
      "additionalProperties": false
    },
    "t1Record": {
      "type": "object",
      "required": ["kind", "case_ids", "modules", "expanded_modules", "blocked_suites", "promotion"],
      "properties": {
        "kind": {"const": "t1"},
        "commit": {"type": ["string", "null"]},
        "fingerprint": {"type": ["string", "null"]},
        "tree_oid": {"type": ["string", "null"]},
        "baseline_commit": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/status"},
        "results_file": {"type": ["string", "null"]},
        "case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "expanded_modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blocked_suites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "updated_at": {"type": ["string", "null"], "format": "date-time"},
        "promotion": {
          "type": ["object", "null"],
          "required": ["from_fingerprint", "commit", "tree_oid", "promoted_at"],
          "properties": {
            "from_fingerprint": {"type": "string"},
            "commit": {"type": "string"},
            "tree_oid": {"type": "string"},
            "promoted_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "t2Record": {
      "type": "object",
      "required": ["kind", "case_ids", "modules", "expanded_modules", "blocked_suites", "selector_id"],
      "properties": {
        "kind": {"const": "t2"},
        "commit": {"type": ["string", "null"]},
        "fingerprint": {"type": ["string", "null"]},
        "tree_oid": {"type": ["string", "null"]},
        "baseline_commit": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/status"},
        "results_file": {"type": ["string", "null"]},
        "case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "expanded_modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blocked_suites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "updated_at": {"type": ["string", "null"], "format": "date-time"},
        "selector_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "t3Record": {
      "type": "object",
      "required": ["kind", "case_ids", "modules", "expanded_modules", "blocked_suites", "release_gate", "coverage"],
      "properties": {
        "kind": {"const": "t3"},
        "commit": {"type": ["string", "null"]},
        "fingerprint": {"type": ["string", "null"]},
        "tree_oid": {"type": ["string", "null"]},
        "baseline_commit": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/status"},
        "results_file": {"type": ["string", "null"]},
        "case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "expanded_modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blocked_suites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "updated_at": {"type": ["string", "null"], "format": "date-time"},
        "release_gate": {"enum": ["passed", "failed", "blocked", "unknown", "provisional", null]},
        "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "releaseGateRecord": {
      "type": ["object", "null"],
      "required": ["decision", "commit", "fingerprint", "results_file", "updated_at"],
      "properties": {
        "decision": {"enum": ["passed", "failed", "blocked", "unknown", "provisional"]},
        "commit": {"type": ["string", "null"]},
        "fingerprint": {"type": ["string", "null"]},
        "results_file": {"type": ["string", "null"]},
        "updated_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
